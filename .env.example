# ══════════════════════════════════════════════════════════════════════
# structr.ai — environment contract
# Copy to .env and fill in real values:  cp .env.example .env
# ══════════════════════════════════════════════════════════════════════

# ── Core (always required) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:6543/postgres
JWT_SECRET=change-me-to-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:3000
PORT=3000
NODE_ENV=development

# ══════════════════════════════════════════════════════════════════════
# SUPABASE AUTH V1
# ══════════════════════════════════════════════════════════════════════
# Which authentication provider validates requests.
#   supabase → Supabase GoTrue email/password + Authorization: Bearer <access_token>
#   legacy   → Manus OAuth cookie session (rollback path, code preserved)
# Default when unset: supabase
AUTH_PROVIDER=supabase

# Server-side Supabase configuration.
# SUPABASE_URL is REQUIRED when AUTH_PROVIDER=supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional. Only for legacy Supabase projects that still sign JWTs with HS256.
# Leave empty to verify tokens against the project JWKS (asymmetric, recommended).
# SUPABASE_JWT_SECRET=

# Transitional only. While AUTH_PROVIDER=supabase, accept a valid legacy session
# cookie when a request carries no bearer token. Keep OFF unless mid-cutover.
SUPABASE_AUTH_ALLOW_LEGACY_FALLBACK=false

# Browser-side Supabase configuration (Vite, injected at build time).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# Mirrors AUTH_PROVIDER for the SPA. Must match the server value.
VITE_AUTH_PROVIDER=supabase

# ══════════════════════════════════════════════════════════════════════
# LEGACY MANUS OAUTH (required only when AUTH_PROVIDER=legacy)
# ══════════════════════════════════════════════════════════════════════
# OAUTH_SERVER_URL=https://oauth.example.com
# OWNER_OPEN_ID=owner-external-open-id
# VITE_APP_ID=your-app-id
# VITE_OAUTH_PORTAL_URL=https://portal.example.com

# ── Session hardening (optional) ──────────────────────────────────────
SESSION_TTL_DAYS=7
SESSION_REFRESH_THRESHOLD_DAYS=1
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=

# ── Content Security Policy (optional) ────────────────────────────────
# off | report-only | enforce
# CSP_MODE=enforce
# CSP_REPORT_URI=

# ── Tenant isolation ──────────────────────────────────────────────────
# ROW axis (F15 / issue #10): tolerate legacy rows whose tenant_id is still NULL.
# Flip to true only after the backfill has verified zero NULLs on every
# tenant-scoped table — turning it on early makes legacy rows disappear.
TENANT_STRICT=false

# CALLER axis (B2 / Codex P1-1): REQUIRED for authenticated business access in
# local development.
#
# An authenticated caller whose tenant cannot be resolved is now refused by the
# tenant-aware procedure boundary — NULL is not a tenant and grants nothing.
# The dev-bypass profile (NODE_ENV=development + the dev JWT secret) is synthetic
# and carries no tenant of its own, so without DEV_TENANT_ID every business route
# returns "No tenant is assigned to this account (10005)".
#
# Previously this was masked: resolveTenantId() silently substituted the default
# (GCHI) tenant for any profile without one, so the dev profile "just worked" —
# against the primary production tenant's data. That substitution is gone.
#
# Set it to an existing tenants.id (not a secret — a plain UUID):
#   DEV_TENANT_ID=00000000-0000-0000-0000-000000000000
# DEV_TENANT_ID=

# Narrow lead reads/writes to the leads each caller owns (on top of the tenant
# scope, which always applies). Off by default: teammates in one tenant share the
# lead pipeline. Turn on only after owner_user_id has been backfilled.
# LEADS_OWNER_SCOPE=false

# ── External services (optional) ──────────────────────────────────────
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
