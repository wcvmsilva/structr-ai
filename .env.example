# ═══════════════════════════════════════════════════════════════════
# structr.ai — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────────
# DATABASE_URL: PostgreSQL connection string. Production targets Supabase
# via the connection pooler on port 6543. Local dev can point at any
# PostgreSQL 14+ instance.
#   Supabase pooled: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Local:           postgresql://postgres:postgres@localhost:5432/structr_ai
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# JWT_SECRET: 32+ random bytes. NEVER reuse the placeholder below in production.
JWT_SECRET=your-secret-key-here

OAUTH_SERVER_URL=https://your-oauth-provider.com
OWNER_OPEN_ID=your-owner-open-id

# ── Optional ─────────────────────────────────────────────────────
VITE_APP_ID=structr-ai
BUILT_IN_FORGE_API_URL=https://api.example.com
BUILT_IN_FORGE_API_KEY=your-api-key
PORT=5000

# ── Security ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5000
